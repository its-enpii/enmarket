diff --git a/apps/web/next.config.ts b/apps/web/next.config.ts
index 1ac73f5..f808f0c 100644
--- a/apps/web/next.config.ts
+++ b/apps/web/next.config.ts
@@ -4,6 +4,27 @@ import createNextIntlPlugin from 'next-intl/plugin';
 const withNextIntl = createNextIntlPlugin('./i18n/request.ts');
 
 const nextConfig: NextConfig = {
+  async rewrites() {
+    const apiInternal =
+      process.env.API_INTERNAL_URL ||
+      (process.env.NEXT_PUBLIC_API_URL?.startsWith('http://api')
+        ? process.env.NEXT_PUBLIC_API_URL
+        : 'http://api:8000');
+
+    return [
+      {
+        source: '/api/:path*',
+        destination: `${apiInternal}/api/:path*`,
+      },
+    ];
+  },
+  // Server Actions: naikkan body size limit untuk upload file produk (max 1GB).
+  
+  experimental: {
+    serverActions: {
+      bodySizeLimit: '1gb',
+    },
+  },
   // `npm run dev` di dalam container dengan bind mount host (Windows host
   // + Linux container). fs.inotify watcher bawaan sering tidak mendeteksi
   // perubahan di bind mount cross-OS — pakai polling fallback.
diff --git a/infra/docker-compose.yml b/infra/docker-compose.yml
index 5b7fdb2..13ce116 100644
--- a/infra/docker-compose.yml
+++ b/infra/docker-compose.yml
@@ -15,7 +15,7 @@ services:
       MYSQL_PASSWORD: ${DB_PASSWORD:-secret}
     ports:
       # Host port hardcoded ke 3307 agar tidak bentrok dengan MySQL lokal Windows di 3306.
-      - "3307:3306"
+      - "3308:3306"
     volumes:
       - db_data:/var/lib/mysql
       - ./docker/db/init.sql:/docker-entrypoint-initdb.d/01-init.sql:ro
diff --git a/infra/docker/api/Dockerfile b/infra/docker/api/Dockerfile
index 4138885..3a53cdb 100644
--- a/infra/docker/api/Dockerfile
+++ b/infra/docker/api/Dockerfile
@@ -37,6 +37,9 @@ RUN apt-get update && apt-get install -y --no-install-recommends \
 # Install PHP extensions
 RUN docker-php-ext-install pdo pdo_mysql mbstring gd zip bcmath
 
+# Custom PHP settings — upload limit 1GB untuk file produk
+COPY infra/docker/api/php-uploads.ini /usr/local/etc/php/conf.d/99-uploads.ini
+
 # Install Composer
 COPY --from=composer:2.8 /usr/bin/composer /usr/bin/composer
 
diff --git a/infra/nginx/store.enpiistudio.com.conf b/infra/nginx/store.enpiistudio.com.conf
index 19e59a6..025cd8b 100644
--- a/infra/nginx/store.enpiistudio.com.conf
+++ b/infra/nginx/store.enpiistudio.com.conf
@@ -18,6 +18,9 @@
 #   5. Tab Advanced → paste konfigurasi di bawah (bagian location /api/ dan /download/)
 #
 
+# Upload file produk bisa sampai 1GB — set global supaya semua location inherit.
+client_max_body_size 1g;
+
 # ───── API routes — bypass Next.js, langsung ke Laravel ─────
 location /api/ {
     proxy_pass http://api:8000;
